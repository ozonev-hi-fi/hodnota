{
  "permissions": {
    "allow": [
      "Bash(npm ci *)",
      "Bash(tasklist)",
      "Bash(npm run *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(docker compose *)",
      "Bash(jobs -l)",
      "Bash(dotnet tool *)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\\\n\" http://localhost:5009/openapi/v1.json)",
      "Bash(powershell -Command \"Get-NetTCPConnection -LocalPort 5009 -ErrorAction SilentlyContinue | Select-Object -ExpandProperty OwningProcess | Sort-Object -Unique\")",
      "Bash(powershell -Command \"Stop-Process -Id 18172 -Force -ErrorAction SilentlyContinue\")",
      "Bash(docker exec *)",
      "Bash(dotnet format *)",
      "Bash(echo \"EXIT: $?\")",
      "Bash(echo \"FORMAT_EXIT: $?\")"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Write(.env)",
      "Write(.env.local)",
      "Bash(cat .env)",
      "Bash(cat .env.local)"
    ],
    "additionalDirectories": [
      "\\tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-adr-comment.js",
            "statusMessage": "Checking for ADR-duplicating comments..."
          }
        ]
      }
    ]
  }
}
